// REBUILT from how the code uses the database. If your real project has prisma/schema.prisma, use that file instead,
// or run `npx prisma db pull` to regenerate this one from your live database. Never run `prisma db push` with this file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  icon      String?
  order     Int       @default(0)
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String
  priceFrom   Int
  priceTo     Int
  variantNote String?
  image       String
  originalUrl String?
  popular     Boolean  @default(false)
  available   Boolean  @default(true)
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique
  customerName  String
  customerPhone String
  customerEmail String?
  address       String
  city          String?
  totalAmount   Int
  paymentMethod String      @default("COD")
  transactionId String?
  paymentStatus String      @default("PENDING")
  status        String      @default("NEW")
  notes         String?
  items         OrderItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  name      String
  price     Int
  quantity  Int
  image     String?
}

model CateringEnquiry {
  id            String    @id @default(cuid())
  name          String
  phone         String
  email         String?
  eventType     String
  eventDate     DateTime?
  guestCount    Int?
  location      String?
  preferredDish String?
  notes         String?
  status        String    @default("NEW")
  read          Boolean   @default(false)
  createdAt     DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  email     String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
